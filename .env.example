# ── Telegram бот (обязательно для продакшена) ─────────────────────────
# Создай бота у @BotFather, включи Mini App и подставь токен
BOT_TOKEN=
# Публичный HTTPS-адрес мини-приложения (ngrok / свой домен)
WEBAPP_URL=https://your-domain.example
# Telegram ID админов через запятую — они видят чат поддержки
ADMIN_IDS=

# ── Подписка ───────────────────────────────────────────────────────────
# Цена для витрины в рублях и реальная цена инвойса в Telegram Stars (XTR)
PRICE_RUB=270
PRICE_STARS=180

# ── Безопасность ───────────────────────────────────────────────────────
# Длинная случайная строка: подпись токенов и шифрование сессий аккаунтов
APP_SECRET=change-me-to-a-long-random-string

# ── Привязка Telegram-аккаунтов (агрегатор) ───────────────────────────
# Получить на https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=

# ── 2ГИС: поиск компаний без сайта ─────────────────────────────────────
# Ключ Places API: https://dev.2gis.com  (без ключа источник выключен)
TWOGIS_KEY=
# Города и ниши через ; — "город|запрос"
TWOGIS_QUERIES=Москва|кофейня;Москва|салон красоты;Санкт-Петербург|стоматология;Казань|фитнес клуб

# ── Разработка ─────────────────────────────────────────────────────────
PORT=8787
# 1 = вход без Telegram (dev-пользователь), оплату можно «симулировать»
DEV_AUTH=1
